# Copie para .env e preencha. NUNCA faça commit do .env.

# --- Claude (escolhe os momentos e escreve título/legenda) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# --- Transcrição (qualquer API compatível com /audio/transcriptions) ---
# Padrão: Groq (console.groq.com), barato e rápido.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Twitch (opcional: clipes mais vistos) — dev.twitch.tv/console ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Shorts — Google Cloud, YouTube Data API v3, OAuth "Desktop app" ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# gerado por: npm run clipper -- auth:youtube
YOUTUBE_REFRESH_TOKEN=

# --- TikTok — developers.tiktok.com, Content Posting API, escopo video.publish ---
# Use o access token direto OU (recomendado) client key/secret + refresh token.
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Instagram Reels — conta Profissional + app na Meta com instagram_content_publish ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_HOST=graph.facebook.com
# INSTAGRAM_GRAPH_VERSION=v23.0

# --- yt-dlp (opcional) ---
# Arquivo de cookies (formato Netscape) para vídeos que pedem login.
# YTDLP_COOKIES=./cookies.txt
# YTDLP_ARGS=
