# Copie para .env e preencha. NUNCA faça commit do .env.

# --- Claude (escolhe os momentos e escreve título/legenda) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Esforço da triagem (escolher os momentos) e do editor (refinar cada corte):
# CLAUDE_EFFORT=high
# CLAUDE_EDIT_EFFORT=medium

# --- Transcrição (qualquer API compatível com /audio/transcriptions) ---
# Padrão: Groq (console.groq.com), barato e rápido.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Twitch (opcional: clipes mais vistos) — dev.twitch.tv/console ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Shorts — Google Cloud, YouTube Data API v3, OAuth "Desktop app" ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# gerado por: npm run clipper -- auth:youtube
YOUTUBE_REFRESH_TOKEN=

# --- TikTok — developers.tiktok.com (Login Kit Desktop + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# depois rode: npm run clipper -- auth:tiktok   (salva o login em data/tiktok-token.json)
# TIKTOK_REDIRECT_URI=http://localhost:53683/callback/

# --- Instagram Reels — app na Meta ("Instagram API com login do Facebook") ---
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:53684/callback
# META_LOGIN_CONFIG_ID=      (só se o app usar "Facebook Login for Business" com configuração)
# preenchidos pelo: npm run clipper -- auth:instagram
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_VERSION=v27.0

# --- yt-dlp (opcional) ---
# Arquivo de cookies (formato Netscape) para vídeos que pedem login.
# YTDLP_COOKIES=./cookies.txt
# YTDLP_ARGS=
